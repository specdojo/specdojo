{
  "name": "specdojo",
  "version": "0.2.0",
  "description": "SpecDojo CLI, schemas, and documentation for specification-driven execution workflows.",
  "license": "MIT",
  "author": "naoji3x",
  "private": false,
  "type": "module",
  "bin": {
    "specdojo": "dist/specdojo.js"
  },
  "files": [
    "dist",
    "docs/ja/specdojo",
    "!docs/ja/specdojo/**/generated/**",
    "docs/specdojo",
    "!docs/specdojo/**/generated/**",
    "templates",
    "README.md",
    "LICENSE"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/specdojo/specdojo.git"
  },
  "homepage": "https://github.com/specdojo/specdojo#readme",
  "bugs": {
    "url": "https://github.com/specdojo/specdojo/issues"
  },
  "keywords": [
    "specdojo",
    "cli",
    "specification",
    "project-management",
    "workflow"
  ],
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "prepare": "node tools/install-lefthook.mjs",
    "pre-commit": "lefthook run pre-commit",
    "build": "node -e \"require('node:fs').rmSync('dist', { recursive: true, force: true })\" && tsc -p tsconfig.build.json && node -e \"require('node:fs').chmodSync('dist/specdojo.js', 0o755)\"",
    "build:if-stale": "node tools/build-if-stale.mjs",
    "test": "vitest run",
    "test:unit": "vitest run --config vitest.unit.config.ts",
    "test:integration": "vitest run --config vitest.integration.config.ts",
    "test:watch": "vitest",
    "test:e2e": "npm run build && tsx tools/e2e/exec-run-e2e.ts",
    "dev": "tsx src/specdojo.ts",
    "start": "node dist/specdojo.js",
    "prepack": "npm run build",
    "specdojo:build": "npm run build",
    "vscode:install": "npm --prefix packages/vscode-specdojo ci",
    "vscode:build": "npm --prefix packages/vscode-specdojo run compile",
    "vscode:package": "npm --prefix packages/vscode-specdojo run package",
    "exec:watch-claude-log": "tools/exec/watch-claude-log.sh",
    "worktree:sync": "tools/worktree/sync.sh",
    "orch:sonnet": "claude --agent specdojo-orchestrator --model sonnet",
    "orch:sonnet:work": "tools/worktree/open-agent-worktree.sh claude-work claude --agent specdojo-orchestrator --model sonnet",
    "orch:opus": "claude --agent specdojo-orchestrator --model opus",
    "orch:opus:work": "tools/worktree/open-agent-worktree.sh claude-work claude --agent specdojo-orchestrator --model opus",
    "orch:terra": "codex -m gpt-5.6-terra \"$(cat .agents/specdojo-orchestrator.agent.md)\"",
    "orch:terra:work": "tools/worktree/open-agent-worktree.sh codex-work codex -m gpt-5.6-terra \"$(cat .agents/specdojo-orchestrator.agent.md)\"",
    "orch:sol": "codex -m gpt-5.6-sol \"$(cat .agents/specdojo-orchestrator.agent.md)\"",
    "orch:sol:work": "tools/worktree/open-agent-worktree.sh codex-work codex -m gpt-5.6-sol \"$(cat .agents/specdojo-orchestrator.agent.md)\"",
    "orch:copilot": "copilot --agent specdojo-orchestrator",
    "orch:copilot:work": "tools/worktree/open-agent-worktree.sh copilot-work copilot --agent specdojo-orchestrator",
    "orch:agy": "agy --add-dir \"$(pwd)\" --model gemini-3.1-pro-high -i \"$(cat .agents/specdojo-orchestrator.agent.md)\"",
    "orch:agy:work": "tools/worktree/open-agent-worktree.sh agy-work agy --add-dir \"$(pwd)\" --model gemini-3.1-pro-high -i \"$(cat .agents/specdojo-orchestrator.agent.md)\"",
    "orch:qwen": "opencode --agent qwen-orchestrator",
    "orch:qwen:work": "tools/worktree/open-agent-worktree.sh qwen-work opencode --agent qwen-orchestrator",
    "orch:gemma": "opencode --agent gemma-orchestrator",
    "orch:gemma:work": "tools/worktree/open-agent-worktree.sh gemma-work opencode --agent gemma-orchestrator",
    "code:red": "tools/vscode/open-worktree-workspace.sh red",
    "code:blue": "tools/vscode/open-worktree-workspace.sh blue",
    "code:green": "tools/vscode/open-worktree-workspace.sh green",
    "typecheck": "tsc -b --noEmit",
    "lint:ts": "eslint 'src/**/*.ts' 'tests/**/*.ts' 'packages/docs-lint/src/**/*.ts' 'tools/e2e/**/*.ts'",
    "lint:ts:fix": "eslint --fix 'src/**/*.ts' 'tests/**/*.ts' 'packages/docs-lint/src/**/*.ts' 'tools/e2e/**/*.ts'",
    "lint:orchestrator-sync": "node tools/validate-orchestrator-sync.mjs",
    "lint:md": "node packages/docs-lint/bin/specdojo-docs-lint.js markdownlint '**/*.md'",
    "lint:md:fix": "node packages/docs-lint/bin/specdojo-docs-lint.js markdownlint --fix '**/*.md'",
    "format": "prettier --write '**/*.{ts,js,mjs,cjs,json,yaml,yml,md}'",
    "format:check": "prettier --check '**/*.{ts,js,mjs,cjs,json,yaml,yml,md}'",
    "docs:generate": "tsx src/specdojo.ts build",
    "docs:dev": "npm run docs:generate && npm --prefix packages/docs-site run docs:dev",
    "docs:build:mermaid": "npm --prefix packages/docs-site run docs:build:mermaid",
    "docs:rebuild:mermaid": "rm -f public/mermaid/*.svg && npm run docs:build:mermaid",
    "docs:build": "npm run docs:generate && npm --prefix packages/docs-site run docs:build",
    "lint:fm": "node packages/docs-lint/bin/specdojo-docs-lint.js remark \"docs/**/*.{md,mdx}\" --quiet --frail",
    "validate:schema:job-run": "node packages/docs-lint/bin/specdojo-docs-lint.js yaml-schema --schema docs/specdojo/schemas/v1/job-run.schema.yaml --data \"docs/ja/**/execution/jobs/runs/*.json\" --allow-empty",
    "validate:schema:grade-pipeline": "node packages/docs-lint/bin/specdojo-docs-lint.js yaml-schema --schema docs/specdojo/schemas/v1/grade-pipeline-state.schema.yaml --data \"docs/ja/**/execution/grade/pipeline/*.json\" --allow-empty",
    "validate:schema:file": "node packages/docs-lint/bin/specdojo-docs-lint.js yaml-schema",
    "validate:schema": "npm run validate:schema:yaml && npm run validate:schema:job-run && npm run validate:schema:grade-pipeline && npm run validate:schema:rulebook-enums",
    "validate:schema:rulebook-enums": "node packages/docs-lint/bin/specdojo-docs-lint.js rulebook-schema-enums",
    "validate:catalog": "tsx src/specdojo.ts catalog validate",
    "validate:history-links": "node packages/docs-lint/bin/specdojo-docs-lint.js history-links",
    "check": "npm run typecheck && npm run lint:ts && npm run lint:md && npm run lint:fm && npm run validate:schema && npm run validate:catalog && npm run validate:history-links && npm test",
    "dc:ps": "docker ps --format \"table {{.Names}}\\t{{.Image}}\\t{{.Status}}\"",
    "dc:name": "bash -lc 'docker ps --format \"{{.Names}}\\t{{.Image}}\" | awk \"\\$2 ~ /^vsc-specdojo/ {print \\$1; exit}\"'",
    "dc:bash": "bash -lc 'name=$(docker ps --format \"{{.Names}}\\t{{.Image}}\" | awk \"\\$2 ~ /^vsc-specdojo/ {print \\$1; exit}\"); [ -n \"$name\" ] && docker exec -it --detach-keys=\"ctrl-]\" -e LANG=C.UTF-8 -e LC_ALL=C.UTF-8 -u node \"$name\" bash -lc \"cd /workspaces/specdojo-workspace/specdojo && exec bash\" || echo \"matching container not found\"'",
    "vscode:ps": "bash .devcontainer/kill-stale-vscode.sh --list",
    "vscode:kill-stale": "bash .devcontainer/kill-stale-vscode.sh",
    "specdojo:exec:opencode": "specdojo exec run --auto --loop --parallel 1 --edit-by opencode-edit-agent --review-by opencode-review-agent > logs/exec-opencode.stdout.log 2> logs/exec-opencode.stderr.log",
    "specdojo:exec:auto": "specdojo exec run --auto --loop --parallel 1 > logs/exec-auto.stdout.log 2> logs/exec-auto.stderr.log",
    "specdojo:exec:auto2": "specdojo exec run --auto --loop --parallel 2 > logs/exec-auto.stdout.log 2> logs/exec-auto.stderr.log",
    "specdojo:exec:auto3": "specdojo exec run --auto --loop --parallel 3 > logs/exec-auto.stdout.log 2> logs/exec-auto.stderr.log",
    "validate:schema:yaml": "node packages/docs-lint/bin/specdojo-docs-lint.js yaml-schema --modeline"
  },
  "dependencies": {
    "ajv": "^8.20.0",
    "commander": "^15.0.0",
    "dotenv": "^17.4.2",
    "fast-glob": "^3.3.3",
    "js-yaml": "^4.2.0",
    "prettier": "^3.8.4",
    "remark-parse": "^11.0.0",
    "unified": "^11.0.5"
  },
  "devDependencies": {
    "@commitlint/cli": "^21.0.2",
    "@commitlint/config-conventional": "^21.0.2",
    "@types/js-yaml": "^4.0.9",
    "@types/node": "^25.9.2",
    "@typescript-eslint/eslint-plugin": "^8.61.0",
    "@typescript-eslint/parser": "^8.61.0",
    "ajv-cli": "^5.0.0",
    "ajv-formats": "^3.0.1",
    "cloc": "^2.6.0-cloc",
    "eslint-config-prettier": "^10.1.8",
    "gray-matter": "^4.0.3",
    "lefthook": "^2.1.9",
    "markdownlint-cli": "^0.48.0",
    "remark": "^15.0.1",
    "remark-cli": "^12.0.1",
    "remark-frontmatter": "^5.0.0",
    "remark-gfm": "^4.0.1",
    "remark-lint": "^10.0.1",
    "remark-lint-frontmatter-schema": "^3.15.4",
    "remark-mdx": "^3.1.1",
    "remark-stringify": "^11.0.0",
    "tsx": "^4.22.4",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.61.0",
    "vitest": "^4.1.8"
  }
}
