{
  "name": "@specdojo/docs-lint",
  "version": "0.1.0",
  "description": "Markdown plugins and document validation commands for SpecDojo projects.",
  "license": "MIT",
  "author": "naoji3x",
  "private": false,
  "type": "module",
  "bin": {
    "specdojo-docs-lint": "bin/specdojo-docs-lint.js"
  },
  "exports": {
    "./remark/md-content": "./src/remark-md-content.cjs",
    "./remark/no-unescaped-angle-placeholder": "./src/remark-no-unescaped-angle-placeholder.cjs",
    "./remark/frontmatter-ajv2020": "./src/remark-frontmatter-ajv2020.cjs"
  },
  "files": [
    "bin",
    "src",
    "README.md",
    "LICENSE"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/specdojo/specdojo.git",
    "directory": "packages/docs-lint"
  },
  "homepage": "https://github.com/specdojo/specdojo#readme",
  "bugs": {
    "url": "https://github.com/specdojo/specdojo/issues"
  },
  "publishConfig": {
    "access": "public"
  },
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "lint:md": "node bin/specdojo-docs-lint.js markdownlint",
    "lint:fm": "node bin/specdojo-docs-lint.js remark"
  },
  "dependencies": {
    "ajv": "^8.20.0",
    "ajv-formats": "^3.0.1",
    "fast-glob": "^3.3.3",
    "gray-matter": "^4.0.3",
    "js-yaml": "^4.2.0",
    "markdownlint-cli": "^0.48.0",
    "remark": "^15.0.1",
    "remark-cli": "^12.0.1",
    "remark-frontmatter": "^5.0.0",
    "remark-gfm": "^4.0.1",
    "remark-lint": "^10.0.1",
    "remark-lint-frontmatter-schema": "^3.15.4",
    "remark-mdx": "^3.1.1",
    "remark-parse": "^11.0.0",
    "remark-stringify": "^11.0.0",
    "tsx": "^4.22.4",
    "unified": "^11.0.5"
  },
  "devDependencies": {
    "@types/js-yaml": "^4.0.9",
    "@types/node": "^25.9.2",
    "typescript": "^6.0.3"
  }
}
