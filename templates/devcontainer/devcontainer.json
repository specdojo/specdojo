{
  "name": "specdojo-agent-env",
  "image": "mcr.microsoft.com/devcontainers/typescript-node:22",
  "remoteUser": "node",
  "init": true,
  "workspaceMount": "source=${localWorkspaceFolder}/..,target=/workspaces/specdojo-workspace,type=bind,consistency=cached",
  "workspaceFolder": "/workspaces/specdojo-workspace/${localWorkspaceFolderBasename}",
  "features": {
    "ghcr.io/devcontainers/features/common-utils:2": {
      "installZsh": false,
      "upgradePackages": false
    }
  },
  "mounts": [
    "source=specdojo-git,target=/home/node/.config/git,type=volume",
    "source=specdojo-gh,target=/home/node/.config/gh,type=volume"
  ],
  "containerEnv": {
    "GIT_CONFIG_GLOBAL": "/home/node/.config/git/config"
  },
  "postCreateCommand": "bash .devcontainer/post-create.sh",
  "customizations": {
    "vscode": {
      "extensions": []
    }
  }
}
