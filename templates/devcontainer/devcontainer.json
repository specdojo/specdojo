{
  "name": "specdojo-agent-env",
  "image": "mcr.microsoft.com/devcontainers/typescript-node:22",
  "remoteUser": "node",
  "init": true,
  "workspaceMount": "source=${localWorkspaceFolder}/..,target=/workspaces/__SPECDOJO_WORKSPACE_NAME__,type=bind,consistency=cached",
  "workspaceFolder": "/workspaces/__SPECDOJO_WORKSPACE_NAME__/${localWorkspaceFolderBasename}",
  "shutdownAction": "none",
  "features": {
    "ghcr.io/devcontainers/features/common-utils:2": {
      "installZsh": false,
      "upgradePackages": false
    }
  },
  "mounts": ["source=specdojo-git,target=/home/node/.config/git,type=volume"],
  "containerEnv": {
    "GIT_CONFIG_GLOBAL": "/home/node/.config/git/config"
  },
  "remoteEnv": {
    "PATH": "/home/node/.local/bin:${containerEnv:PATH}"
  },
  "postCreateCommand": "bash .devcontainer/post-create.sh",
  "customizations": {
    "vscode": {
      "extensions": []
    }
  }
}
