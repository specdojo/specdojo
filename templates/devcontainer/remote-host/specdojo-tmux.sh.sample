#!/usr/bin/env bash
#
# specdojo-tmux.sh.sample
#
# 常時稼働ホスト上で devcontainer 内の tmux セッションへ入るためのスクリプトです。
# ホスト側の ~/bin/specdojo-tmux.sh などへコピーし、実行権限（chmod +x）を付与して使用してください。
#
# 実際の処理本体は各 workspace の .specdojo/host/devcontainer-tmux.sh が行います。
# 本体のスクリプトは `npx specdojo devcontainer host-script` で書き出せます。
#
# 前提ツール:
#   - Docker (Docker Desktop または Docker Engine)
#   - Dev Container CLI (@devcontainers/cli): コンテナ未作成時のみ起動に使用
#
set -euo pipefail

# ホスト上のワークスペースのパス（実際の配置場所に合わせて書き換えてください）
workspace_dir="${1:-$HOME/<path-to-workspace>/<repo-name>}"

exec "$workspace_dir/.specdojo/host/devcontainer-tmux.sh" "$workspace_dir"
