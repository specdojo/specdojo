" SpecDojo Dev Container Vim defaults.
" This file is copied only when ~/.vimrc and ~/.vim/vimrc do not exist.

set encoding=utf-8
set fileencoding=utf-8
set number
set ruler
set showmatch
set expandtab
set shiftwidth=2
set softtabstop=2
set tabstop=2
set smartindent
set hidden
set wildmenu
set ignorecase
set smartcase
set incsearch
set hlsearch
set mouse=a
set backspace=indent,eol,start

" Keep swap, backup, and undo files outside the worktree.
if exists('*mkdir')
  call mkdir(expand('~/.local/share/vim/swap'), 'p')
  call mkdir(expand('~/.local/share/vim/backup'), 'p')
  call mkdir(expand('~/.local/share/vim/undo'), 'p')
endif
set directory^=~/.local/share/vim/swap//
set backupdir^=~/.local/share/vim/backup//
if has('persistent_undo')
  set undofile
  set undodir^=~/.local/share/vim/undo//
endif

filetype plugin indent on
syntax enable
