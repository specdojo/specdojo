{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "permissions": {
    "deny": [
      "Edit(**)",
      "Bash(git add *)",
      "Bash(git commit *)",
      "Bash(git push)",
      "Bash(git push *)",
      "Bash(gh *)",
      "Bash(/usr/bin/git push)",
      "Bash(/usr/bin/git push *)",
      "Bash(/usr/bin/gh *)",
      "Bash(/usr/local/bin/git push)",
      "Bash(/usr/local/bin/git push *)",
      "Bash(/usr/local/bin/gh *)"
    ]
  }
}
