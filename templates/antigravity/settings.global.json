{
  "permissions": {
    "allow": ["command(git status)", "command(git diff)", "command(git log)", "command(git show)"],
    "deny": [
      "command(git add)",
      "command(git commit)",
      "command(git push)",
      "command(git reset --hard)",
      "command(rm -rf)",
      "command(sudo)",
      "read_file(.env)",
      "read_file(secrets/)",
      "write_file(.git/)",
      "write_file(node_modules/)",
      "write_file(.specdojo/specdojo.config.json)",
      "write_file(.specdojo/exec-defaults.yaml)",
      "write_file(.specdojo/index-config.yaml)",
      "write_file(.specdojo/antigravity/)",
      "write_file(.specdojo/claude/)",
      "write_file(.specdojo/codex/)",
      "write_file(.specdojo/copilot/)",
      "write_file(.specdojo/opencode/)",
      "write_file(.agents/rules/)",
      "write_file(.agents/skills/)",
      "write_file(.claude/)",
      "write_file(.codex/)",
      "write_file(.opencode/)",
      "write_file(.github/agents/)",
      "write_file(.github/workflows/)",
      "write_file(.gitlab/ci/)",
      "write_file(.circleci/)",
      "write_file(.azure-pipelines/)",
      "write_file(.jenkins/)",
      "write_file(package.json)",
      "write_file(AGENTS.md)",
      "write_file(CLAUDE.md)",
      "write_file(GEMINI.md)",
      "write_file(lefthook.yml)",
      "write_file(.lefthook.yml)",
      "write_file(.gitlab-ci.yml)",
      "write_file(.gitlab-ci.yaml)",
      "write_file(azure-pipelines.yml)",
      "write_file(azure-pipelines.yaml)",
      "write_file(Jenkinsfile)",
      "write_file(commitlint.config.js)",
      "write_file(commitlint.config.cjs)",
      "write_file(commitlint.config.mjs)",
      "write_file(commitlint.config.ts)",
      "write_file(.commitlintrc)",
      "write_file(.commitlintrc.json)",
      "write_file(.commitlintrc.yaml)",
      "write_file(.commitlintrc.yml)"
    ]
  }
}
