--- HOOK ---
# Git hooks for development workflow
pre-commit:
  piped: false
  parallel: true
  commands:
    # docs-build（vitepress build）は rendering pages 時にメモリを大量消費し、
    # 環境によっては OOM (exit 137) で commit がブロックされるため pre-commit から外す。
    # フルビルドの検証は CI 側で実行する想定。
    # 整形は prettier に一本化する。
    # md 以外（ts/js/json/yaml）は prettier で整形する。
    format:
      glob: "*.{ts,js,mjs,cjs,json,yaml,yml}"
      run: npx prettier --write {staged_files}
      stage_fixed: true

    # md は prettier で整形してから markdownlint でルール検査する。
    # 別コマンドかつ parallel:true だと「整形前の内容を検査して誤ブロック」する
    # 競合が起きるため、整形→検査を 1 コマンドに連結して順序を保証する。
    markdown:
      glob: "*.md"
      run: npx prettier --write {staged_files} && node packages/docs-lint/bin/specdojo-docs-lint.js markdownlint {staged_files}
      stage_fixed: true

    # SSOT の変更をラッパーと配布テンプレートへ反映する。検査ではなく生成にしているのは、
    # parallel:true で format（prettier）と同時に走るため、検査だけだと「整形前の本文で
    # 比較して通り、整形後の SSOT との差分が commit へ入る」順序事故が起きるからである。
    # 生成は冪等で、prettier が整形しない .toml 側のずれもここで吸収する。
    orchestrator-sync:
      glob: "{.agents/specdojo-orchestrator.agent.md,.claude/agents/specdojo-orchestrator.md,.github/agents/specdojo-orchestrator.md,.codex/agents/specdojo-orchestrator.toml,.opencode/agents/gemma-orchestrator.md,.opencode/agents/qwen-orchestrator.md,templates/*/agents/specdojo-orchestrator.*,templates/antigravity/orchestrator.md}"
      run: npm run orchestrator:sync
      stage_fixed: true

    # tsc -b は staged 単位で実行できないため、プロジェクト全体を型チェックする。
    # tsconfig.build.json（src）だけでなく tests / tools も参照経由で対象になる。
    typecheck:
      glob: "{src/**,tests/**,scripts/**,tools/**,packages/docs-lint/**,tsconfig*.json}"
      run: npm run typecheck

    test:
      glob: "{src/**,tests/**,docs/ja/specdojo/templates/**,docs/ja/specdojo/exec-templates/**,vitest.config.*}"
      run: npm test

    # *-build 系は generated/ 配下を出力するが、generated/ は gitignore 済みの生成物
    # （VitePress build 前段の docs:generate で再生成する）。ここでは再生成のみ行い、
    # commit には含めない（stage_fixed しない）。ローカル作業ツリーを最新化しつつ、
    # 入力変更でビルドが壊れていないことの確認も兼ねる。
    register-build:
      glob: "docs/**/project-register/*.md"
      run: npx tsx src/specdojo.ts register build

    catalog-build:
      glob: "docs/**/dct-*.yaml"
      run: npx tsx src/specdojo.ts catalog build

    catalog-validate:
      glob: "docs/ja/projects/**"
      run: npx tsx src/specdojo.ts catalog validate

    exec-refresh:
      glob: "docs/**/sch-*.yaml"
      run: npx tsx src/specdojo.ts exec refresh

    index-build:
      glob: "docs/**"
      # doc-index.json も gitignore 済みの生成物。再生成のみ行い commit に含めない。
      run: npx tsx src/specdojo.ts index build

commit-msg:
  commands:
    commitlint:
      run: npx commitlint --edit $1

# Git が pre-push の標準入力へ渡す remote ref を検査する。リモート名にかかわらず
# refs/heads/main への更新だけを拒否し、develop / feature / exec は妨げない。
pre-push:
  commands:
    protect-main:
      run: node tools/protect-main-push.mjs
      use_stdin: true

# specdojo の bin は dist/specdojo.js を指すため、merge / checkout で src が更新された
# あとに再ビルドしないと、CLI が古い挙動のまま動く（PJR-CMYX）。src が dist より新しい
# 場合だけ再ビルドし、それ以外は何もしない。失敗しても hook を止めない best-effort。
post-merge:
  commands:
    build-if-stale:
      run: node tools/build-if-stale.mjs

post-checkout:
  commands:
    build-if-stale:
      run: node tools/build-if-stale.mjs

