t', 'elk', str(source), str(target)], capture_output=True, text=True)\n            if result.returncode:\n                raise RuntimeError(result.stderr)\n            edges = re.findall(r'^([a-z_]+)\\s*(?:->|<-)\\s*([a-z_]+):', block, re.M)\n            counts = Counter(node for edge in edges for node in edge)\n            print(f'{kind}-{index}: SVG rendered; edges={len(edges)}; maximum incident edges={max(counts.values())}; diagram unchanged')\nPY","status":"passed","summary":"全 4 図が変更前と同一で、ELK による SVG 出力に成功。sample の線数は 10・4 本、最多集中は 5・4 本。一時ファイルは削除済み。"},{"command":"git diff --check","status":"passed","summary":"最終差分に空白エラーなし。"}]}
