# yaml-language-server: $schema=../docs/specdojo/schemas/v1/exec-defaults.schema.yaml
# exec-defaults.yaml
# specdojo exec run の共通実行設定。
#
# エージェント選択に使う作業要件（mode / capabilities / proficiency）は
# sch-strategy-<track>.yaml の phase に定義する。
#
# rate_limit_detection / rate_limit_policy は全 provider 共通のグローバル既定値。
# 検出シグナル・終了コード・待機時間は provider ごとに異なるため、provider 別の
# 上書きは providers.<provider> に置く（キーは pm-members[].provider に対応）。
# member ごとに、対応する provider ブロックがあればそれを、なければ下のグローバル
# 既定を使う。検出は候補ごとに provider で解決し、retry/backoff の policy は最優先
# 候補（candidates[0]）の provider で解決する。

# executor の sandbox では実行できない検証を、executor 成功後・reporter 起動前に
# SpecDojo 親プロセスが固定許可リストから実行する。設定できるのは ID だけで、agent の
# evidence や設定ファイルから任意の command / 引数を注入することはできない。
pipeline:
  parent_validations:
    # lint は短時間で終わるため先に実行し、executor が残した ESLint・frontmatter・Markdown の
    # エラーを統合前に検出する（PJR-K1Z5）。
    - lint-ts # npm run lint:ts
    - lint-fm # npm run lint:fm
    - lint-md # npm run lint:md
    - test-integration # npm run test:integration（shell を介さず固定 argv で実行）
    # sandbox 内では tsx の IPC ソケット作成、Vitest の終了、git の子プロセス終了が
    # 成立せず、成果物と無関係に failed となるため親プロセスで実行する（PJR-QVGX）。
    - validate-schema # npm run validate:schema
    # 型エラーは Vitest では検出できず、統合時の pre-commit hook まで持ち越されるため、
    # test-unit の前に親検証として実行する（PJR-W66B）。
    - typecheck # npm run typecheck
    - test-unit # npm run test:unit

rate_limit_detection:
  # exit_codes は最小限にする。多くの agent CLI は通常失敗と agent 自身の block も
  # exit 1 で返すため、素の exit 1 は rate limit と区別できない。通常失敗を利用制限
  # として延期しないよう、共通既定では exit code 単独の検出を行わない。
  exit_codes: []
  # stderr_patterns は既定で「プロセスが非ゼロ終了した場合のみ」rate limit とみなす
  # （stderr_requires_nonzero_exit の既定は true）。成果物本文に "rate limit" 等の
  # 語が含まれ、agent が成功（exit 0）したままその差分を stderr に出力しても誤検出
  # しない。終了コードに依らず stderr のみで判定したい場合は false を明示する。
  stderr_patterns:
    - "rate limit"
    - "429"

rate_limit_policy:
  # provider 出力に reset / retry-after が無い一時的な rate limit だけ、明示した
  # cooldown を再開時刻として使用する。quota_exhausted は自動再開しない。
  cooldown_seconds:
    rate_limit: 900
  on_non_critical:
    action: skip # cpm.slack > 0: block イベントを記録して次のタスクへ
  on_critical:
    action: try_next # cpm.slack == 0: candidates 配列の次の agent へ
    retry:
      max_attempts: 3
      initial_wait_seconds: 60
      backoff_multiplier: 3 # 60s -> 180s -> 540s
      max_wait_seconds: 600
    on_exhausted: block # 全候補試行後はブロックして人間に委ねる

# provider 別の設定。command_template は agent の起動コマンドで、member 属性
# （{nickname} / {mode} / {proficiency} と command_params の変数）で展開する。
# member 側の command はテンプレートを持たない構成（provider: custom 等）専用の上書き。
#
# 検出・ポリシー上書きは、各 provider ブロックの rate_limit_detection を
# 与えた場合、その provider の member ではグローバル rate_limit_detection を完全に
# 置き換える（exit_codes を省略すれば exit code 起因の誤検出を避けられる）。
#
# limit の種類は provider ごとに異なる（rate limit / session limit / 週次・月次 quota）。
# reset horizon により retryable と回復戦略が変わるため、詳細は各 provider 設計書の
# limit 表を参照する。stderr の実文言は CLI バージョンで変わりうるため、下記 pattern は
# 実際の出力で検証してから確定する。
providers:
  claude:
    # モデルは .claude/agents/{nickname}.md の model フィールドで指定するため、
    # テンプレートにモデル名を含めない。permission は mode 別 settings で分離する。
    command_template: "claude -p --verbose --agent {nickname} --settings .specdojo/claude/settings.{mode}.json"
    # Anthropic API: 429 / rate limit に加え、モデル高負荷時の overloaded を検出。
    # session limit は logs/exec-auto.log で実観測:
    #   "You've hit your session limit · resets 4:10am (UTC)"
    # （rate limit / 429 を含まないため exit 1 ではなくこの文言で検出する必要がある）
    rate_limit_detection:
      stderr_patterns:
        - "rate limit"
        - "429"
        - "overloaded"
        - "session limit"

  copilot:
    # edit / review とも同一の許可リスト方式（shell は読み取り系・検証系のみ、git の
    # 変更系は deny）。write はパス単位に絞れないため許可し、成果物変更の境界は
    # specdojo CLI の commit 許可リストで作る。プレースホルダは不要のため使わない。
    # model は auto（Copilot の自動モデル選択）で常に最新・最適なモデルへ追従する。
    # ローカル config に persist された model 設定に依存しないよう明示する。
    command_template: >-
      copilot -p "$(cat)" --no-color --no-ask-user --model auto
      --no-remote --no-remote-export --disable-builtin-mcps
      --allow-tool write
      --allow-tool 'shell(git status)' --allow-tool 'shell(git diff)'
      --allow-tool 'shell(git log)' --allow-tool 'shell(git show)'
      --allow-tool 'shell(npm run)' --allow-tool 'shell(npm test)'
      --allow-tool 'shell(specdojo:*)'
      --deny-tool 'shell(git add)' --deny-tool 'shell(git commit)'
      --deny-tool 'shell(git push)' --deny-tool 'shell(git reset)'
    # Copilot: 429 / rate limit に加え、quota / premium request 上限の文言を検出。
    rate_limit_detection:
      stderr_patterns:
        - "rate limit"
        - "429"
        - "quota"
        - "premium request"

  codex:
    # codex exec には worker 名を選択するオプションがないため {nickname} は使わず、
    # モデルと reasoning effort を proficiency で切り替える。--ephemeral は rollout
    # ファイルを保存しない（実行履歴の正本は SpecDojo の event・plan・result）。
    # sandbox_workspace_write.network_access=false は sandbox 内からの直接の
    # ネットワークアクセスを遮断する（web_search はモデル側ツールのため影響しない）。
    command_template: 'codex exec --ephemeral --sandbox workspace-write -c approval_policy="never" -c sandbox_workspace_write.network_access=false --model {model} -c model_reasoning_effort="{effort}"'
    command_params:
      by_proficiency:
        normal: { model: gpt-5.6-terra, effort: medium }
        expert: { model: gpt-5.6-sol, effort: high }
    # OpenAI: 429 / rate limit（API）に加え、ChatGPT プランの 5時間枠（session limit）
    # と週次上限（weekly / usage limit）がスタックする。
    rate_limit_detection:
      stderr_patterns:
        - "rate limit"
        - "429"
        - "session limit"
        - "weekly limit"
        - "usage limit"

  opencode:
    # {nickname} が --agent の指定名になるため、member の nickname と
    # .opencode/agents/<name>.md のファイル名を一致させる。
    command_template: "opencode run --agent {nickname}"
    # 同一ホストの単一 Ollama モデルを共有するため、複数の opencode agent を同時起動
    # するとメモリ競合・モデルロード待ちで不安定になる。1 ラウンドで同時に走る opencode
    # を 1 つに制限する（他 provider のグローバル --parallel は下げない）。
    max_concurrency: 1
    # ローカル Ollama: API rate limit より、モデルロード待ち・メモリ不足・接続
    # タイムアウトが主な失敗要因。exit 1 は実失敗なので exit_codes は空にする。
    rate_limit_detection:
      exit_codes: []
      stderr_patterns:
        - "timeout"
        - "connection refused"
        - "out of memory"
        - "model is loading"
    # 同一ホストの OpenCode provider を共有するため、別 member への try_next でも
    # モデル切替・メモリ不足は解消しないことがある。復旧は wait+backoff を優先する。
    rate_limit_policy:
      on_non_critical:
        action: skip
      on_critical:
        action: try_next
        retry:
          max_attempts: 3
          initial_wait_seconds: 120 # モデル再ロード/メモリ解放に時間がかかるため長め
          backoff_multiplier: 2 # 120s -> 240s -> 480s
          max_wait_seconds: 600
        on_exhausted: block

  antigravity:
    # Antigravity CLI（agy）は --agent による定義ファイルの選択を持たず、codex と同じく
    # プロンプト（plan）だけで役割を与える。-p はプロンプトを引数に取り stdin を読まないため、
    # runner が stdin へ書く plan を "$(cat)" で引数に渡す（shell: true で実行される）。
    # --sandbox は書き込み先を ~/.gemini 配下の scratch へ逃がすため、--add-dir で作業
    # ディレクトリ（worktree）を明示して成果物へ書けるようにする（2026-09-21 実測）。
    # --dangerously-skip-permissions は非対話実行に必須。境界は worktree・保護設定・
    # commit 許可リストで作る。
    # agy のモデル ID は推論強度を含む（gemini-3.8-flash-{high,medium,low} など）。--effort を
    # 併用すると ID と食い違ったときに "invalid model selection" で起動に失敗するため、
    # 強度はモデル ID だけで指定する（2026-09-21 実測: flash-high + --effort medium で失敗）。
    command_template: 'agy --sandbox --add-dir "$(pwd)" --dangerously-skip-permissions --model {model} -p "$(cat)"'
    command_params:
      by_proficiency:
        normal: { model: gemini-3.8-flash-medium }
        expert: { model: gemini-3.1-pro-high }
      # Gemini 以外の Antigravity 提供モデルは member nickname で明示的に選ぶ。
      # by_nickname は proficiency / mode の既定値より優先される。
      by_nickname:
        agy-claude-executor: { model: claude-sonnet-4-6 }
        agy-claude-expert-executor: { model: claude-opus-4-6-thinking }
        agy-claude-expert-review-executor: { model: claude-opus-4-6-thinking }
        agy-gpt-executor: { model: gpt-oss-120b-medium }
    # Gemini API の制限文言は未観測。429 / quota / RESOURCE_EXHAUSTED を初期値とし、
    # 実観測した文言で更新する（observed-agent-limit-stderr と同じ扱い）。
    rate_limit_detection:
      stderr_patterns:
        - "rate limit"
        - "429"
        - "quota"
        - "RESOURCE_EXHAUSTED"
# SpecDojo Orchestrator Agent

あなたは SpecDojo の対話型オーケストレーターです。利用者との会話から意図を読み取り、`specdojo` CLI（`register` / `exec` / `kata` / `catalog` / `schedule` / `routine` など）を用いてプロジェクト実行管理を代行します。1件のタスクを黙々と処理する edit / review agent とは異なり、あなたは会話を通じて「何をしたいか」を明確化し、適切なコマンドへ落とし込み、実行と報告を行う司令塔です。

CLI は利用リポジトリへローカル導入されるため、`npx specdojo <command>` で起動する。`node_modules/.bin` が `PATH` に入る環境（VS Code 統合ターミナルなど）では `specdojo` と打てるが、提示するコマンドは `npx specdojo` で統一する。

## 基本方針

- 回答は原則として日本語で行う。
- コマンドは「提案 → 承認 → 実行」の順で扱う。状態やファイルを変える操作は、実行するコマンドを提示して利用者の承認を得てから実行する。読み取り・状況確認のみのコマンド（`--help`、`list`、`status`、`where`、`validate`、`--dry-run`）は説明の上で実行してよい。
- 破壊的変更や `git push` は行わない。
- `git commit` は次の方針で行う。実行前に必ず現在のブランチを確認して提示し、`main` では commit しない（対象ブランチを提案して止まる）。
  - register の状態遷移や worktree の統合など、runner 相当の記帳は承認なしに commit してよい。register の記帳は `--commit` で commit する。
  - 自分が判断して書いた変更（実装・設定・規範文書など）は、対象ファイルと commit メッセージを提示して承認を得てから commit する。
- commit 先のブランチは変更の種類で決める。作業を始める前に現在ブランチを確認し、想定と違う場合は切り替えを提案してから進める。
  - register の記帳（起票・状態遷移・生成物の再構築）は、対象 project の `develop` へ直接 commit してよい。個票とイベントが項目ごとに分かれ、ID も乱数で採番されるため、並行しても衝突しない。
  - 自分が内容を書いた変更（実装・設定・規範文書など）は `feature/<project-id>/<topic>` を切ってそこへ commit する。`git push` と PR 作成は行わず、コマンドを提示して利用者へ引き渡す。
  - `exec run` は現在ブランチを統合先にするため、実行前に対象 project の `develop` にいることを確認する。
  - exec に流す予定の `todo` は、実行前に対象 project の `develop` へ入れておく。worktree は commit から作られるため、feature ブランチにしかない個票は実行できない。
- commit メッセージは subject を日本語で書き、conventional commit の type と scope を保つ。本文には「なぜ」を日本語で書き、関連する登録簿項目があれば `Refs: <project-id>:<PJR-XXXX>`（例: `Refs: prj-0001:PJR-36QG`）を記載する。項目ごとに 1 行とし、過去の commit の書式は書き換えない。
- 登録簿項目の実行は既定で `exec run --register` を使う。自分で実装するのは、利用者が実装者として自分を指定した場合に限る。「着手してください」は実行経路の指示であり、自分が実装してよい根拠として扱わない。実装者が読み取れない場合は確認する。
- 自分が直接対応した項目は `start` を経ずに `close` してよい。実行していない主体を actor とする遷移を、記録の体裁を揃える目的で追加しない。終端イベントの `reason` に対応経路を記録し、実施内容と検証結果は個票の対応結果へ残す。
- 認証情報・秘密鍵・`.env`・`secrets/` を読み込まない。
- 変更前に関連する設計書（`docs/ja/specdojo/guides/`、`docs/ja/specdojo/references/command-reference.md`）を確認する。
- タスクに関係しない成果物やファイルを変更しない。プロジェクトの事実を捏造しない。不明点は推測で埋めず、利